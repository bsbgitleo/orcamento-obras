// prisma/schema.prisma
// Fonte: 02-modelo-dados-e-regras.md (v0.1) + 01-especificacao-app-v0.2.md + 06-tcu-engenharia-custos-regras.md
// Convenções: nomes em inglês; dinheiro Decimal(15,2); quantidades/coeficientes Decimal(15,4);
// percentuais Decimal(7,4). Todo preço carrega fonte + UF + mês de referência + regime.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum ProjectType {
  PUBLIC // obra pública (licitação)
  PRIVATE // obra privada
}

enum ProjectCategory {
  RESIDENTIAL_BUILDING
  COMMERCIAL_BUILDING
  SCHOOL
  HEALTH_UNIT
  PAVING
  DRAINAGE
  SANITATION
  RENOVATION
  OTHER
}

enum BudgetStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
  ARCHIVED
}

enum TaxRegime {
  DESONERADO
  NAO_DESONERADO
  SEM_ENCARGOS // tabelas ISE/CSE do SINAPI (mão de obra sem encargos sociais)
}

enum PriceOrigin {
  SINAPI
  SICRO
  PROPRIA
  COTACAO
}

enum InputKind {
  MATERIAL
  MAO_DE_OBRA
  EQUIPAMENTO
  SERVICO
}

enum CompositionItemType {
  INSUMO
  COMPOSICAO_AUXILIAR
  /// SICRO: acréscimo percentual sobre a soma da seção (ex.: "Instalações… (10.00%)")
  PERCENTUAL
}

enum WbsNodeKind {
  STAGE // etapa / subetapa
  SERVICE // serviço com composição e quantidade
}

/// Faixas do Acórdão TCU 2622/2013, item 9.1
enum TcuWorkType {
  EDIFICACOES
  RODOVIAS_FERROVIAS
  REDES_AGUA_ESGOTO
  PORTUARIAS_MARITIMAS_FLUVIAIS
  ESTACOES_REDES_ENERGIA_ELETRICA
  FORNECIMENTO_MATERIAIS_EQUIPAMENTOS
}

// ───────────────────────── Empresa e usuários (SaaS, decisões #30 e #35) ─────────────────────────

/// Papel do usuário na empresa. MANAGER administra usuários e aprova orçamentos.
enum Role {
  MANAGER // gestor: aprova orçamentos, administra a empresa e os usuários
  ESTIMATOR // orçamentista: cria e edita orçamentos e cadastros
  VIEWER // leitura
}

model Company {
  id            String                 @id @default(cuid())
  name          String
  document      String? // CNPJ
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  memberships   Membership[]
  sessions      Session[]
  clients       Client[]
  bdiProfiles   BdiProfile[]
  socialCharges SocialChargesProfile[]
  priceTables   PriceTable[]
  projects      Project[]
  ownInputs       OwnInput[]
  ownCompositions OwnComposition[]
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  name               String
  passwordHash       String
  /// Obriga a trocar a senha no próximo login (usuário convidado com senha inicial)
  mustChangePassword Boolean      @default(false)
  /// Administrador da plataforma (acima das empresas): importa as bases oficiais compartilhadas
  isPlatformAdmin    Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  memberships        Membership[]
  sessions           Session[]
  importJobs         ImportJob[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role     @default(ESTIMATOR)
  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
}

/// Sessão em cookie; guarda só o hash SHA-256 do token.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
}

// ───────────────────────── Cadastros ─────────────────────────

model Client {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  document  String? // CNPJ/CPF
  email     String?
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@index([companyId])
}

/// BDI nomeado e reutilizável. Percentuais em %, ex.: 4.0000 = 4 %.
model BdiProfile {
  id                    String      @id @default(cuid())
  companyId             String
  company               Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String
  workType              TcuWorkType @default(EDIFICACOES)
  centralAdministration Decimal     @db.Decimal(7, 4)
  insurance             Decimal     @db.Decimal(7, 4)
  risk                  Decimal     @db.Decimal(7, 4)
  guarantee             Decimal     @db.Decimal(7, 4)
  financialExpenses     Decimal     @db.Decimal(7, 4)
  profit                Decimal     @db.Decimal(7, 4)
  pis                   Decimal     @db.Decimal(7, 4)
  cofins                Decimal     @db.Decimal(7, 4)
  iss                   Decimal     @db.Decimal(7, 4) // alíquota efetiva no município
  cprb                  Decimal     @default(0) @db.Decimal(7, 4)
  /// Resultado da fórmula TCU, em %, 2 casas (desnormalizado para relatório)
  percent               Decimal     @db.Decimal(7, 2)
  notes                 String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  budgetsAsMain         Budget[]    @relation("BudgetMainBdi")
  budgetsAsSupply       Budget[]    @relation("BudgetSupplyBdi")

  @@index([companyId])
}

/// Tabela de encargos sociais reutilizável. Percentuais em %.
model SocialChargesProfile {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  regime     TaxRegime
  hourlyPct  Decimal   @db.Decimal(7, 4) // horista
  monthlyPct Decimal   @db.Decimal(7, 4) // mensalista
  source     String? // ex.: "SINAPI DF 2026-10"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  budgets    Budget[]

  @@index([companyId])
}

// ───────────────────────── Base de preços ─────────────────────────

/// Uma tabela de preços = origem + UF + mês de referência + regime (rastreabilidade).
model PriceTable {
  id                   String        @id @default(cuid())
  /// null = base oficial compartilhada por todas as empresas; preenchido = base própria da empresa
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  origin               PriceOrigin
  uf                   String        @db.Char(2)
  referenceMonth       String        @db.Char(7) // "2026-10"
  regime               TaxRegime
  importedAt           DateTime?
  sourceFile           String?
  /// Encargos sociais sobre a mão de obra publicados com a tabela (fração, ex.: 1.1008 = 110,08 %)
  socialChargesHourly  Decimal?      @db.Decimal(7, 4)
  socialChargesMonthly Decimal?      @db.Decimal(7, 4)
  inputs               Input[]
  compositions         Composition[]
  budgets              Budget[]

  @@unique([companyId, origin, uf, referenceMonth, regime])
  @@index([companyId])
}

model Input {
  id              String            @id @default(cuid())
  priceTableId    String
  priceTable      PriceTable        @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  code            String
  description     String
  unit            String
  kind            InputKind
  /// null = sem preço nesta UF/mês ("SEM PREÇO" no SINAPI)
  /// SINAPI publica 2 casas; SICRO, 4
  unitPrice       Decimal?          @db.Decimal(15, 4)
  /// SICRO, equipamentos: custo horário produtivo e improdutivo (R$/h)
  productiveCost   Decimal?         @db.Decimal(15, 4)
  unproductiveCost Decimal?         @db.Decimal(15, 4)
  /// Classificação original da fonte (SINAPI: MATERIAL, MAO DE OBRA, EQUIPAMENTO (AQUISIÇÃO), ENCARGOS COMPLEMENTARES...)
  sourceClass     String?
  /// Origem de preço SINAPI: C = coletado, CR = coef. de representatividade, AS = atribuído por similaridade
  priceOrigin     String?
  /// UF de onde o preço foi herdado quando a UF pedida estava em branco (o SINAPI usa SP)
  priceFallbackUf String?           @db.Char(2)
  /// Nível na hierarquia da Lei 14.133 art. 23 §2º (1–4); null em obra privada
  sourceLevel     Int?
  sourceNote      String? // site/data-hora de acesso, cotação etc.
  usages          CompositionItem[] @relation("ItemInput")

  @@unique([priceTableId, code])
  @@index([description])
  @@index([priceTableId])
}

model Composition {
  id            String            @id @default(cuid())
  priceTableId  String
  priceTable    PriceTable        @relation(fields: [priceTableId], references: [id], onDelete: Cascade)
  code          String
  description   String
  unit          String
  /// Grupo da fonte (SINAPI: "Acessibilidade", "Alvenaria"...)
  group         String?
  /// Custo unitário publicado pela fonte (CSD/CCD/CSE) — usado para conferir o cálculo
  referenceCost Decimal?          @db.Decimal(15, 2)
  /// SICRO: produção da equipe (unidades por hora) e fator de influência de chuvas
  productionRate Decimal?         @db.Decimal(18, 7)
  fic            Decimal?         @db.Decimal(9, 5)
  /// Custo unitário calculado pelo app a partir dos itens (cache; null = incompleta / sem custo)
  unitCost      Decimal?          @db.Decimal(15, 2)
  /// Percentual de mão de obra no custo (relatório "mão de obra" do SINAPI), fração 0–1
  laborShare    Decimal?          @db.Decimal(7, 4)
  /// Situação na fonte (SINAPI: COM CUSTO | SEM CUSTO | EM ESTUDO)
  sourceStatus  String?
  /// Composição própria derivada de uma oficial (TCU §3): guarda a origem e a justificativa.
  derivedFromId String?
  derivedFrom   Composition?      @relation("Derivation", fields: [derivedFromId], references: [id])
  derivations   Composition[]     @relation("Derivation")
  justification String?
  items         CompositionItem[] @relation("ParentComposition")
  usedAsChild   CompositionItem[] @relation("ChildComposition")
  services      WbsNode[]

  @@unique([priceTableId, code])
  @@index([description])
  @@index([priceTableId])
  @@index([derivedFromId])
}

model CompositionItem {
  id                 String              @id @default(cuid())
  compositionId      String
  composition        Composition         @relation("ParentComposition", fields: [compositionId], references: [id], onDelete: Cascade)
  type               CompositionItemType
  inputId            String?
  input              Input?              @relation("ItemInput", fields: [inputId], references: [id])
  childCompositionId String?
  childComposition   Composition?        @relation("ChildComposition", fields: [childCompositionId], references: [id])
  coefficient        Decimal             @db.Decimal(18, 7) // SINAPI publica até 7 casas
  /// Ordem do item na composição (no SICRO a linha percentual soma o grupo até ali)
  position           Int?
  /// SICRO: grupo do item (A equipamentos, B mão de obra, C material, D auxiliares, E tempo fixo, F transporte)
  sicroGroup         String?             @db.Char(1)
  /// SICRO, equipamentos: utilização operativa e improdutiva
  operativeUse       Decimal?            @db.Decimal(9, 5)
  unproductiveUse    Decimal?            @db.Decimal(9, 5)
  /// SICRO, PERCENTUAL: percentual (10 = 10 %) e rótulo publicado
  percent            Decimal?            @db.Decimal(9, 4)
  label              String?
  /// SICRO, transporte (F): códigos das composições de transporte por via [LN, RP, P]
  transportCodes     String[]

  @@index([compositionId])
  @@index([inputId])
  @@index([childCompositionId])
}

// ───────────────────────── Obra e orçamento ─────────────────────────

model Project {
  id              String          @id @default(cuid())
  companyId       String
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code            String // gerado automaticamente, único por empresa
  name            String
  type            ProjectType
  category        ProjectCategory
  clientId        String?
  client          Client?         @relation(fields: [clientId], references: [id])
  address         String?
  uf              String          @db.Char(2)
  deadlineDays    Int?
  // Campos de licitação (só quando type = PUBLIC)
  biddingModality String?
  biddingNumber   String?
  biddingAgency   String?
  biddingOpensAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  budgets         Budget[]

  @@unique([companyId, code])
  @@index([clientId])
}

/// Uma revisão do orçamento (R0, R1, ...).
model Budget {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revision   Int          @default(0) // R0, R1...
  status     BudgetStatus @default(DRAFT)
  notes      String?
  approvedBy String?
  approvedAt DateTime?

  priceTableId String
  priceTable   PriceTable @relation(fields: [priceTableId], references: [id])

  bdiId       String
  bdi         BdiProfile  @relation("BudgetMainBdi", fields: [bdiId], references: [id])
  /// BDI reduzido para mero fornecimento (Súmula TCU 253); opcional
  supplyBdiId String?
  supplyBdi   BdiProfile? @relation("BudgetSupplyBdi", fields: [supplyBdiId], references: [id])

  socialChargesId String
  socialCharges   SocialChargesProfile @relation(fields: [socialChargesId], references: [id])

  /// Duração do cronograma físico-financeiro (meses)
  scheduleMonths Int @default(6)

  // Totais desnormalizados (recalculados a cada alteração)
  directCost Decimal @default(0) @db.Decimal(15, 2)
  salePrice  Decimal @default(0) @db.Decimal(15, 2)

  nodes     WbsNode[]
  schedule  ScheduleEntry[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([projectId, revision])
  @@index([priceTableId])
  @@index([bdiId])
  @@index([supplyBdiId])
  @@index([socialChargesId])
}

/// EAP: etapas (STAGE) e serviços (SERVICE) na mesma tabela, em árvore.
/// `code` (1, 1.1, 1.1.1) é recalculado pelo app a partir de parentId + position.
model WbsNode {
  id          String      @id @default(cuid())
  budgetId    String
  budget      Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      WbsNode?    @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children    WbsNode[]   @relation("Tree")
  kind        WbsNodeKind
  position    Int
  code        String
  description String

  // Só para SERVICE
  compositionId String?
  composition   Composition? @relation(fields: [compositionId], references: [id])
  /// Serviço com composição própria da empresa (em vez de compositionId) — decisão #51
  ownCompositionId String?
  ownComposition   OwnComposition? @relation(fields: [ownCompositionId], references: [id])
  unit          String?
  quantity      Decimal?     @db.Decimal(15, 4)
  unitCost      Decimal?     @db.Decimal(15, 2) // custo unitário = custo da composição
  totalCost     Decimal?     @db.Decimal(15, 2) // TRUNC(qtd × unitCost, 2)
  unitPrice     Decimal?     @db.Decimal(15, 2) // TRUNC(unitCost × (1 + BDI), 2)
  totalPrice    Decimal?     @db.Decimal(15, 2) // TRUNC(qtd × unitPrice, 2)
  /// Item de mero fornecimento → usa supplyBdi do orçamento
  isSupplyItem  Boolean      @default(false)

  schedule ScheduleEntry[]

  @@unique([budgetId, parentId, position])
  @@index([budgetId])
  @@index([parentId])
  @@index([compositionId])
  @@index([ownCompositionId])
}

/// Cronograma físico-financeiro: percentual por mês por etapa raiz.
model ScheduleEntry {
  id       String  @id @default(cuid())
  budgetId String
  budget   Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  nodeId   String
  node     WbsNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  month    Int // 1..N
  percent  Decimal @db.Decimal(7, 4)

  @@unique([nodeId, month])
  @@index([budgetId])
}

// ---------------------------------------------------------------------------
// Importação das bases oficiais pela interface (decisões #32–#34, #45–#47)
// ---------------------------------------------------------------------------

enum ImportJobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

/// Uma importação enviada pela tela Bases → Importar. Roda em segundo plano no
/// servidor; o progresso fica em `log` (uma linha por evento).
model ImportJob {
  id          String          @id @default(cuid())
  origin      PriceOrigin     @default(SINAPI)
  status      ImportJobStatus @default(QUEUED)
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  ufs         String[]
  regimes     TaxRegime[]
  /// Nomes dos arquivos enviados (como vieram do navegador)
  fileNames   String[]
  log         String          @default("")
  error       String?
  /// Resumo por UF/regime e das manutenções (JSON)
  result      Json?
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([createdById])
  @@index([status])
}

/// Relatório de manutenções da base oficial (SINAPI_Manutenções_AAAA_MM.xlsx).
/// O arquivo é cumulativo e nacional: cada importação substitui todas as linhas
/// da origem. Serve para alertar orçamentos feitos em referência anterior.
model SourceMaintenance {
  id             String      @id @default(cuid())
  origin         PriceOrigin
  /// Mês em que a manutenção entrou em vigor ("2026-10")
  referenceMonth String      @db.Char(7)
  /// INSUMO | COMPOSICAO
  itemType       String
  code           String
  description    String
  /// Texto da Caixa: DESATIVAÇÃO, ALTERAÇÃO DE ITENS/COEFICIENTES…
  maintenance    String
  /// Mês do arquivo de onde a linha veio
  fileMonth      String      @db.Char(7)

  @@index([origin, code])
  @@index([origin, referenceMonth])
}

// ---------------------------------------------------------------------------
// Base própria da empresa (decisões #36, #51–#53)
// ---------------------------------------------------------------------------

/// Insumo que não existe na base oficial: preço cotado com fonte e data.
model OwnInput {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String
  description String
  unit        String
  kind        InputKind
  /// Preço unitário (mão de obra: já com encargos)
  unitPrice   Decimal   @db.Decimal(15, 2)
  /// Data do preço (cotação, nota fiscal…)
  priceDate   DateTime  @db.Date
  /// Fornecedor, cotação, nota fiscal, site…
  source      String
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  usages      OwnCompositionItem[]

  @@unique([companyId, code])
  @@index([companyId])
}

/// Composição da empresa. Os itens oficiais são guardados pelo código e
/// precificados na base do orçamento em que a composição é usada (#51).
model OwnComposition {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code          String
  description   String
  unit          String
  group         String?
  /// Composição oficial de origem, quando criada por cópia (ex.: SINAPI 87879)
  derivedFromOrigin PriceOrigin?
  derivedFromCode   String?
  /// Por que a composição foi criada ou adaptada (exigida pelo TCU em obra pública)
  justification String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OwnCompositionItem[] @relation("OwnParent")
  usedAsChild   OwnCompositionItem[] @relation("OwnChild")
  services      WbsNode[]

  @@unique([companyId, code])
  @@index([companyId])
}

enum OwnItemType {
  OFFICIAL_INPUT
  OFFICIAL_COMPOSITION
  OWN_INPUT
  OWN_COMPOSITION
}

model OwnCompositionItem {
  id               String          @id @default(cuid())
  compositionId    String
  composition      OwnComposition  @relation("OwnParent", fields: [compositionId], references: [id], onDelete: Cascade)
  position         Int
  type             OwnItemType
  /// Itens oficiais: origem + código (resolvidos na base do orçamento)
  officialOrigin   PriceOrigin?
  officialCode     String?
  /// Descrição e unidade do item oficial quando foi incluído (exibição se não existir na base)
  officialDescription String?
  officialUnit     String?
  ownInputId       String?
  ownInput         OwnInput?       @relation(fields: [ownInputId], references: [id])
  ownCompositionId String?
  ownComposition   OwnComposition? @relation("OwnChild", fields: [ownCompositionId], references: [id])
  coefficient      Decimal         @db.Decimal(18, 7)

  @@index([compositionId])
  @@index([ownInputId])
  @@index([ownCompositionId])
}
